rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
         request.auth.token.email == 'sandy78997@gmail.com');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
    }

    match /menuItems/{menuItemId} {
      function isValidMenuItem(data) {
        return data.keys().hasAll(['name', 'category', 'priceTeaMilk', 'priceMilkTea', 'badges', 'createdAt', 'updatedAt']) &&
               data.size() == 7 &&
               data.name is string && data.name.size() <= 100 &&
               data.category is string && data.category.size() <= 100 &&
               data.priceTeaMilk is number && data.priceTeaMilk >= 0 &&
               data.priceMilkTea is number && data.priceMilkTea >= 0 &&
               data.badges is list && data.badges.size() <= 10 &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow read: if true;
      
      allow create: if isAdmin() &&
                    isValidId(menuItemId) &&
                    isValidMenuItem(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      
      allow update: if isAdmin() &&
                    isValidId(menuItemId) &&
                    isValidMenuItem(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().createdAt == existing().createdAt;
      
      allow delete: if isAdmin() && isValidId(menuItemId);
    }

    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['userId', 'customerName', 'status', 'totalPrice', 'items', 'createdAt', 'updatedAt']) &&
               data.size() == 7 &&
               data.userId is string && data.userId == request.auth.uid &&
               data.customerName is string && data.customerName.size() <= 50 &&
               data.status is string && data.status.matches('^(pending|preparing|completed|cancelled)$') &&
               data.totalPrice is number && data.totalPrice >= 0 &&
               data.items is list && data.items.size() <= 50 &&
               (data.items.size() == 0 || (
                 data.items[0].keys().hasAll(['menuItemId', 'name', 'variant', 'price', 'quantity', 'ice', 'sugar']) &&
                 data.items[0].menuItemId is string
               )) &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }
      
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                    isValidId(orderId) &&
                    isValidOrder(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    incoming().status == 'pending';

      allow update: if isValidId(orderId) && (
        (isAdmin() &&
         isValidOrder(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().updatedAt == request.time &&
         incoming().createdAt == existing().createdAt
        ) ||
        (isSignedIn() && existing().userId == request.auth.uid &&
         isValidOrder(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         existing().status == 'pending' &&
         incoming().status == 'cancelled' &&
         incoming().updatedAt == request.time &&
         incoming().createdAt == existing().createdAt
        )
      );
    }
  }
}
