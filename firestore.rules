rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      // For this app, I am manually specifying the known admin email.
      // We also check against the userRoles collection.
      return request.auth != null && (
        request.auth.token.email == "sandy78997@gmail.com" || 
        (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSignedIn() {
      // In this environment, email_verified is not actively used, but we check if request.auth is real.
      return request.auth != null; 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- MenuItem Rules ---
    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'isAvailable'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.isAvailable is bool
        && (data.keys().hasAll(['imageUrl']) ? (data.imageUrl is string && data.imageUrl.size() <= 500) : true)
        && (data.keys().hasAll(['badges']) ? (data.badges is list && data.badges.size() <= 5) : true)
        && (data.keys().hasAll(['milkTeaPrice']) ? (data.milkTeaPrice is number && data.milkTeaPrice >= 0) : true);
    }

    match /menuItems/{itemId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() 
        && isValidId(itemId) 
        && isValidMenuItem(incoming())
        && incoming().keys().size() <= 7;
      allow update: if isAdmin() 
        && isValidId(itemId)
        && isValidMenuItem(incoming());
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // --- Order Rules ---
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'status', 'items', 'totalAmount', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.status is string && data.status in ['pending', 'preparing', 'completed', 'cancelled']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() 
        && isValidId(orderId) 
        && isValidOrder(incoming()) 
        && incoming().keys().size() == 6
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
        && isValidId(orderId) 
        && isValidOrder(incoming()) 
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || 
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) 
            && existing().status == 'pending' 
            && incoming().status == 'cancelled'
          )
        );

      allow delete: if false; // Orders cannot be deleted, only cancelled
    }

    // --- UserRoles Rules ---
    match /userRoles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() 
        && isValidId(userId)
        && incoming().keys().hasAll(['role'])
        && incoming().keys().size() == 1
        && incoming().role in ['admin', 'customer'];
      allow delete: if false;
    }
  }
}
